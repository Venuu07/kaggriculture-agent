# Copy to .env and fill in ONE key. Never commit .env.
# Which provider the LLM agent uses: gemini | groq | openai | claude | offline
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Free tiers are rate limited; seconds to wait between LLM calls.
LLM_MIN_INTERVAL_S=4
